#!/bin/sh
# Same steps CI runs, locally, before anything reaches GitHub. Red stays on this Mac.
cd "$(git rev-parse --show-toplevel)" || exit 1
export SAMANTHA_HEADLESS=1
for t in tests/test_chat.py tests/test_tools_image.py eval/actions.py eval/web_parity.py tools_util.py tests/test_edges.py; do
  python3 "$t" >/tmp/prepush.log 2>&1 || { echo "pre-push: $t failed, see /tmp/prepush.log"; exit 1; }
done

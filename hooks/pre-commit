#!/bin/bash
# Runs eval/score.py only when a change could plausibly move the score,
# so unrelated commits (docs, landing page CSS, etc.) aren't slowed down.
# A regression here means don't commit it silently, roadmap.md's whole
# point tonight was "catch this stuff before it ships".

changed=$(git diff --cached --name-only)
if echo "$changed" | grep -qE '^(ask\.py|chat\.py|FAQ\.md|eval/prompts\.jsonl)$'; then
  echo "eval-relevant file changed, running eval/score.py..."
  if ! ./.venv/bin/python eval/score.py; then
    echo ""
    echo "eval/score.py failed. Commit blocked."
    echo "If this is expected (e.g. you're mid-fix across commits), commit with --no-verify."
    exit 1
  fi
fi

if echo "$changed" | grep -qE '^(ask\.py|FAQ\.md)$'; then
  echo "matcher-relevant file changed, running eval/faq_paraphrase.py..."
  # Guards recall against natural rephrasings, which prompts.jsonl cannot
  # see (its prompts are worded the way the FAQ words things). Recall was
  # 3/16 before semantic matching landed and is 13/16 now; the floor stops
  # a future matcher change from quietly walking it back. Skips itself when
  # the embedding daemon isn't running, so a machine without Ollama is not
  # blocked from committing.
  if ! ./.venv/bin/python eval/faq_paraphrase.py --min 13; then
    echo ""
    echo "eval/faq_paraphrase.py regressed. Commit blocked."
    echo "If this is expected, commit with --no-verify."
    exit 1
  fi
fi

if echo "$changed" | grep -qE '^(serve\.py|ask\.py)$'; then
  echo "serve.py/ask.py changed, running test_nimble.py..."
  # proves Samantha is still callable as a pluggable engine by other apps.
  # ask.py counts because serve.py is a thin wrapper over ask(), so an
  # ask.py change can break the integration without touching serve.py.
  if ! ./.venv/bin/python test_nimble.py; then
    echo ""
    echo "test_nimble.py failed, the Nimble integration is broken. Commit blocked."
    echo "If this is expected, commit with --no-verify."
    exit 1
  fi
fi

if echo "$changed" | grep -qE '^chat\.py$'; then
  echo "chat.py changed, running test_chat.py..."
  if ! ./.venv/bin/python test_chat.py > /dev/null; then
    echo ""
    echo "test_chat.py failed. Commit blocked."
    echo "If this is expected, commit with --no-verify."
    exit 1
  fi
fi
